  "verdicts": [
    {
      "claim": "the queue ahead melts by the touch's share of the cancel weight: the 20,000+ row at 1,000 events goes from 4.9% to about 20% at 0.5 and about 30% at 0.3",
      "measured": "uniform 4.9%, focused {0.5: '15.1%', 0.3: '19.7%'}",
      "held": false
    },
    {
      "claim": "the traded-to-cancelled ratio from 5,000 shares back falls from 24 to single digits, and does not invert at either strength, because only a third of the cancel events reach a live order and the touch trades ten shares an event",
      "measured": "{0.5: 5.7, 0.3: 3.2}",
      "held": true
    },
    {
      "claim": "the 5,000-20,000 fill rate gains under twenty points at 1,000 events, and 20,000+ still never fills",
      "measured": "gains {0.5: '6.8%', 0.3: '10.9%'}, 20,000+ fills {0.5: '0.0%', 0.3: '0.0%'}",
      "held": true
    },
    {
      "claim": "the break-even queue rises with the focus, past 20,000 shares at 0.3",
      "measured": "uniform 18701.90710382613, focused {0.5: 16404.51612903401, 0.3: 15803.000000002448}",
      "held": false
    },
    {
      "claim": "the markout from 5,000-20,000 back stays positive: where the cancels land changes when you fill, not what the mid does afterwards",
      "measured": "{0.5: 1.53, 0.3: 1.6}",
      "held": true
    },
    {
      "claim": "the held side under the focused flow stays within five points of section 8's fill rates in every bucket, because the spread, the trade count and the live cancel count are the same flow",
      "measured": "largest bucket gap {0.5: '5.8%', 0.3: '5.8%'}",
      "held": false
    }
  ]
